---
/**
 * 旧 URL（/ja/）からトップ（/）への転送ページ。
 * 以前は /ja/ が日本語ページだったので、古いリンクやブックマークをトップへ送る。
 * canonical をトップに向け、検索エンジンにはトップを正規の URL として伝える。
 */
import { BASE, absoluteUrl } from '../../lib/site';

const target = absoluteUrl(BASE, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>石井 健太（Kenta Ishii）</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${BASE}`} />
    <meta name="robots" content="noindex, follow" />
    <script is:inline define:vars={{ to: BASE }}>
      location.replace(to + location.hash);
    </script>
  </head>
  <body>
    <p><a href={BASE}>石井 健太（Kenta Ishii）のポートフォリオはこちらに移動しました。</a></p>
  </body>
</html>
