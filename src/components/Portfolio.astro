---
/**
 * ポートフォリオ本体。ja/en のページはこのコンポーネントに lang を渡すだけ。
 * データの読み込み・並べ替え・構造化データの生成はここで行う。
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import PubList from './PubList.astro';
import PatentList from './PatentList.astro';
import ExhibitionList from './ExhibitionList.astro';
import EntryList from './EntryList.astro';
import type { Entry } from './EntryList.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/utils';
import { t, pick, pickedLang, selfNameVariants } from '../i18n/utils';
import { localePath, absoluteUrl } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

const [profileEntry] = await getCollection('profile');
if (!profileEntry) {
  throw new Error('src/data/profile.yaml が読み込めませんでした。');
}
const profile = profileEntry.data;

// 年の降順。同じ年の中では YAML の記載順（order）を保つ。
const byYearDesc = <T extends { data: { year: number; order: number } }>(a: T, b: T) =>
  b.data.year - a.data.year || a.data.order - b.data.order;
const pubs: CollectionEntry<'publications'>[] = (await getCollection('publications')).sort(byYearDesc);
const patents: CollectionEntry<'patents'>[] = (await getCollection('patents')).sort(byYearDesc);
// 展示は年が不明なものを末尾に（記載順）。
const exhibitions: CollectionEntry<'exhibitions'>[] = (await getCollection('exhibitions')).sort(
  (a, b) => (b.data.year ?? -1) - (a.data.year ?? -1) || a.data.order - b.data.order,
);

/** 多言語フィールドを「ラベル付きの詳細行」にする（値がなければ行を出さない）。 */
const row = (label: string, field: { ja?: string | undefined; en?: string | undefined } | undefined) =>
  field ? [{ label, value: pick(field, lang), lang: pickedLang(field, lang) }] : [];

// 受賞は「何で（会議・コンテスト） + 何の賞か」を 1 行の見出しにし、対象（論文・提案の題名）をラベルなしで添える。
const awardEntries: Entry[] = (await getCollection('awards')).sort(byYearDesc).map(({ data }) => ({
  year: String(data.year),
  title: `${pick(data.event, lang)} ${pick(data.award, lang)}`,
  titleLang: pickedLang(data.event, lang),
  summary: data.subject ? { text: pick(data.subject, lang), lang: pickedLang(data.subject, lang) } : undefined,
  rows: [],
  links: data.link ? [{ label: dict.awards.link, href: data.link }] : [],
}));

const projectEntries: Entry[] = (await getCollection('projects')).sort(byYearDesc).map(({ data }) => ({
  year: String(data.year),
  title: pick(data.title, lang),
  titleLang: pickedLang(data.title, lang),
  summary: data.summary ? { text: pick(data.summary, lang), lang: pickedLang(data.summary, lang) } : undefined,
  rows: [
    ...row(dict.projects.period, data.period),
    ...row(dict.projects.funder, data.funder),
    ...row(dict.projects.role, data.role),
  ],
  links: data.links.map((link) => ({ label: pick(link.label, lang), href: link.url })),
}));

const selfVariants = selfNameVariants(profile.name);
const name = pick(profile.name, lang);
const pageTitle = `${name} — ${pick(profile.specialty, lang)}`;
const path = localePath(lang);

const sameAs = Object.values(profile.links).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  alternateName: pick(profile.name, lang === 'ja' ? 'en' : 'ja'),
  affiliation: profile.affiliations.map((a) => ({ '@type': 'Organization', name: pick(a.org ?? a, lang) })),
  url: absoluteUrl(path, Astro.site),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<Base lang={lang} title={pageTitle} description={dict.meta.description} path={path} jsonLd={jsonLd}>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} profile={profile} />
    <Section
      id="publications"
      number={dict.sections.publications.number}
      title={dict.sections.publications.title}
    >
      <PubList lang={lang} pubs={pubs} selfVariants={selfVariants} />
    </Section>
    <Section id="awards" number={dict.sections.awards.number} title={dict.sections.awards.title}>
      <EntryList lang={lang} entries={awardEntries} />
    </Section>
    <Section id="patents" number={dict.sections.patents.number} title={dict.sections.patents.title}>
      <PatentList lang={lang} patents={patents} selfVariants={selfVariants} note={profile.patentNote} />
    </Section>
    <Section id="projects" number={dict.sections.projects.number} title={dict.sections.projects.title}>
      <EntryList lang={lang} entries={projectEntries} />
    </Section>
    <Section id="exhibitions" number={dict.sections.exhibitions.number} title={dict.sections.exhibitions.title}>
      <ExhibitionList lang={lang} exhibitions={exhibitions} />
    </Section>
    <Section id="contact" number={dict.sections.contact.number} title={dict.sections.contact.title}>
      <Contact lang={lang} profile={profile} />
    </Section>
  </main>
  <Footer lang={lang} name={name} />
</Base>

<script>
  // セクションが表示されたらフェードイン + 上方向移動。reduced-motion 時は即時表示。
  const targets = document.querySelectorAll<HTMLElement>('.reveal');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion || !('IntersectionObserver' in window)) {
    for (const el of targets) el.classList.add('is-visible');
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    for (const el of targets) observer.observe(el);
  }
</script>
