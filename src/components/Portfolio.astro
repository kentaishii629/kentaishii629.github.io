---
/**
 * ポートフォリオ本体。ja/en のページはこのコンポーネントに lang を渡すだけ。
 * データの読み込み・並べ替え・構造化データの生成はここで行う。
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import ResearchList from './ResearchList.astro';
import PubList from './PubList.astro';
import PatentList from './PatentList.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/utils';
import { t, pick, selfNameVariants } from '../i18n/utils';
import { localePath, absoluteUrl } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

const [profileEntry] = await getCollection('profile');
if (!profileEntry) {
  throw new Error('src/data/profile.yaml が読み込めませんでした。');
}
const profile = profileEntry.data;

// 年の降順。同じ年の中では YAML の記載順（order）を保つ。
const byYearDesc = <T extends { data: { year: number; order: number } }>(a: T, b: T) =>
  b.data.year - a.data.year || a.data.order - b.data.order;
const pubs: CollectionEntry<'publications'>[] = (await getCollection('publications')).sort(byYearDesc);
const patents: CollectionEntry<'patents'>[] = (await getCollection('patents')).sort(byYearDesc);

const selfVariants = selfNameVariants(profile.name);
const name = pick(profile.name, lang);
const jobTitle = pick(profile.title, lang);
const pageTitle = `${name} — ${jobTitle}`;
const path = localePath(lang);

const sameAs = Object.values(profile.links).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  alternateName: pick(profile.name, lang === 'ja' ? 'en' : 'ja'),
  jobTitle,
  affiliation: profile.affiliations.map((a) => ({ '@type': 'Organization', name: pick(a, lang) })),
  knowsAbout: profile.research.map((r) => pick(r.title, lang)),
  url: absoluteUrl(path, Astro.site),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<Base lang={lang} title={pageTitle} description={dict.meta.description} path={path} jsonLd={jsonLd}>
  <Header lang={lang} name={name} />
  <main id="main">
    <Hero lang={lang} profile={profile} />
    <Section id="research" number={dict.sections.research.number} title={dict.sections.research.title}>
      <ResearchList lang={lang} items={profile.research} />
    </Section>
    <Section id="publications" number={dict.sections.publications.number} title={dict.sections.publications.title}>
      <PubList lang={lang} pubs={pubs} selfVariants={selfVariants} />
    </Section>
    <Section id="patents" number={dict.sections.patents.number} title={dict.sections.patents.title}>
      <PatentList lang={lang} patents={patents} selfVariants={selfVariants} summary={profile.patentSummary} />
    </Section>
    <Section id="about" number={dict.sections.about.number} title={dict.sections.about.title}>
      <About lang={lang} profile={profile} />
    </Section>
    <Section id="contact" number={dict.sections.contact.number} title={dict.sections.contact.title}>
      <Contact lang={lang} profile={profile} />
    </Section>
  </main>
  <Footer lang={lang} name={name} />
</Base>

<script>
  // セクションが表示されたらフェードイン + 上方向移動。reduced-motion 時は即時表示。
  const targets = document.querySelectorAll<HTMLElement>('.reveal');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion || !('IntersectionObserver' in window)) {
    for (const el of targets) el.classList.add('is-visible');
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    for (const el of targets) observer.observe(el);
  }
</script>
