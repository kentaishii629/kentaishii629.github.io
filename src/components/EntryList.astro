---
import type { Lang } from '../i18n/utils';

/** 年・題名・詳細行・概要・リンクからなる汎用の一覧（受賞・事業で使う）。表示用に整形済みの値を受け取る。 */
export interface Entry {
  /** 左列に出す年（または開始年）。 */
  year: string;
  title: string;
  titleLang: Lang;
  rows: { label: string; value: string; lang: Lang }[];
  summary?: { text: string; lang: Lang } | undefined;
  links: { label: string; href: string }[];
}

interface Props {
  lang: Lang;
  entries: Entry[];
}

const { lang, entries } = Astro.props;
---

<ol class="entries">
  {
    entries.map((entry) => (
      <li>
        <span class="mono year">{entry.year}</span>
        <div class="body">
          <h3 lang={entry.titleLang !== lang ? entry.titleLang : undefined}>{entry.title}</h3>
          {entry.summary && (
            <p class="desc" lang={entry.summary.lang !== lang ? entry.summary.lang : undefined}>
              {entry.summary.text}
            </p>
          )}
          {entry.rows.length > 0 && (
            <dl class="details">
              {entry.rows.map((row) => (
                <>
                  <dt class="label">{row.label}</dt>
                  <dd lang={row.lang !== lang ? row.lang : undefined}>{row.value}</dd>
                </>
              ))}
            </dl>
          )}
          {entry.links.length > 0 && (
            <ul class="links">
              {entry.links.map((link) => (
                <li>
                  <a class="arrow-link" href={link.href} rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .entries > li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem var(--col-gap);
    padding-block: var(--sp-3);
    border-top: var(--hairline);
  }

  .entries > li:last-child {
    border-bottom: var(--hairline);
  }

  .year {
    font-size: 0.8125rem;
    color: var(--color-accent);
    padding-top: 0.3rem;
  }

  h3 {
    margin-bottom: 0.5rem;
  }

  .desc {
    font-size: 0.9375rem;
    margin-bottom: 0.75rem;
    text-wrap: pretty;
  }

  .details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .details dd {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-3);
    margin-top: 0.75rem;
  }

  @media (min-width: 768px) {
    .entries > li {
      grid-template-columns: var(--year-col) 1fr;
    }

    .details {
      grid-template-columns: 6rem 1fr;
    }
  }
</style>
