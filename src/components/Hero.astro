---
import type { Lang } from '../i18n/utils';
import { t, pick, pickedLang } from '../i18n/utils';
import { SECTION_IDS } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}

const { lang, profile } = Astro.props;
const dict = t(lang);
const name = pick(profile.name, lang);
const title = pick(profile.title, lang);
const affiliations = profile.affiliations.map((a) => ({ text: pick(a, lang), lang: pickedLang(a, lang) }));
---

<section class="hero" aria-labelledby="hero-name">
  <div class="container hero-inner">
    <div class="hero-main">
      <p class="eyebrow label">{title}</p>
      <h1 id="hero-name">{name}</h1>
      {
        affiliations.length > 0 && (
          <ul class="affiliations">
            {affiliations.map((a) => (
              <li lang={a.lang !== lang ? a.lang : undefined}>{a.text}</li>
            ))}
          </ul>
        )
      }
    </div>
    <nav class="toc grid-aside" aria-label={dict.hero.scrollHint}>
      <p class="toc-label label" aria-hidden="true">{dict.hero.scrollHint}</p>
      <ol>
        {
          SECTION_IDS.map((id) => (
            <li>
              <a href={`#${id}`}>
                <span class="toc-num mono" aria-hidden="true">
                  {dict.sections[id].number}
                </span>
                <span class="toc-title">{dict.sections[id].title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>

<style>
  .hero-inner {
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + var(--sp-5));
  }

  .hero-main {
    padding-block: var(--sp-2) var(--sp-6);
  }

  .eyebrow {
    margin-bottom: var(--sp-3);
  }

  h1 {
    margin-bottom: var(--sp-4);
  }

  .affiliations {
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    line-height: 1.7;
    color: var(--color-muted);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  .affiliations li {
    padding-left: 1.75em;
    text-indent: -1.75em;
  }

  .affiliations li::before {
    content: '\2014';
    display: inline-block;
    width: 1.75em;
    text-indent: 0;
    color: var(--color-faint);
  }

  .affiliations li + li {
    margin-top: 0.125rem;
  }

  .toc {
    gap: 0 var(--col-gap);
    padding-block: var(--sp-1);
    border-top: var(--hairline);
  }

  .toc-label {
    display: none;
  }

  /* モバイルでは目次らしく 1 行 1 項目、罫線で区切る */
  .toc ol {
    display: grid;
    font-size: 0.8125rem;
  }

  .toc li + li {
    border-top: var(--hairline);
  }

  .toc a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    color: var(--color-muted);
    transition: color 200ms var(--ease);
  }

  .toc a::after {
    content: '\2193';
    margin-left: auto;
    color: var(--color-faint);
    transition: transform 200ms var(--ease);
  }

  .toc a:hover,
  .toc a:focus-visible {
    color: var(--color-fg);
  }

  .toc a:hover::after,
  .toc a:focus-visible::after {
    transform: translateY(2px);
  }

  .toc-num {
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .hero-inner {
      padding-top: calc(var(--header-h) + var(--sp-8));
    }

    .hero-main {
      padding-block: var(--sp-4) var(--sp-10);
    }

    .eyebrow {
      margin-bottom: var(--sp-5);
    }

    h1 {
      margin-bottom: var(--sp-6);
    }

    .toc {
      padding-block: var(--sp-2);
    }

    .toc-label {
      display: block;
      align-self: center;
    }

    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--sp-4);
    }

    .toc li + li {
      border-top: 0;
    }

    .toc a {
      display: inline-flex;
      gap: 0.625rem;
    }

    .toc a::after {
      content: none;
    }
  }
</style>
