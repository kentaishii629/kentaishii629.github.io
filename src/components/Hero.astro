---
import type { Lang } from '../i18n/utils';
import { t, pick, pickedLang } from '../i18n/utils';
import { SECTION_IDS } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}

const { lang, profile } = Astro.props;
const dict = t(lang);
const name = pick(profile.name, lang);
const specialty = { text: pick(profile.specialty, lang), lang: pickedLang(profile.specialty, lang) };
const history = profile.history.map((h) => ({ year: h.year, text: pick(h.text, lang), lang: pickedLang(h.text, lang) }));
const affiliations = profile.affiliations.map((a) => ({ text: pick(a, lang), lang: pickedLang(a, lang) }));
---

<section class="hero" aria-labelledby="hero-name">
  <div class="container hero-inner">
    <div class="hero-main">
      <h1 id="hero-name">{name}</h1>
      <dl class="facts">
        {
          affiliations.length > 0 && (
            <>
              <dt class="label">{dict.hero.affiliation}</dt>
              <dd>
                <ul>
                  {affiliations.map((a) => (
                    <li lang={a.lang !== lang ? a.lang : undefined}>{a.text}</li>
                  ))}
                </ul>
              </dd>
            </>
          )
        }
        <dt class="label">{dict.hero.specialty}</dt>
        <dd lang={specialty.lang !== lang ? specialty.lang : undefined}>{specialty.text}</dd>
        {
          history.length > 0 && (
            <>
              <dt class="label">{dict.hero.history}</dt>
              <dd>
                <ol class="history">
                  {history.map((h) => (
                    <li lang={h.lang !== lang ? h.lang : undefined}>
                      <span class="mono history-year">{h.year}</span>
                      <span>{h.text}</span>
                    </li>
                  ))}
                </ol>
              </dd>
            </>
          )
        }
      </dl>
    </div>
    <nav class="toc grid-aside" aria-label={dict.hero.scrollHint}>
      <p class="toc-label label" aria-hidden="true">{dict.hero.scrollHint}</p>
      <ol>
        {
          SECTION_IDS.map((id) => (
            <li>
              <a href={`#${id}`}>
                <span class="toc-num mono" aria-hidden="true">
                  {dict.sections[id].number}
                </span>
                <span class="toc-title">{dict.sections[id].title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>

<style>
  .hero-inner {
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + var(--sp-5));
  }

  .hero-main {
    padding-block: var(--sp-2) var(--sp-6);
  }

  h1 {
    margin-bottom: var(--sp-4);
  }

  .facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.125rem var(--sp-3);
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .facts dt {
    padding-top: 0.15rem;
  }

  .facts dd {
    margin: 0 0 0.75rem;
  }

  .facts dd:last-child {
    margin-bottom: 0;
  }

  .history li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
  }

  .history-year {
    font-size: 0.75rem;
    color: var(--color-faint);
  }

  .toc {
    gap: 0 var(--col-gap);
    padding-block: var(--sp-1);
    border-top: var(--hairline);
  }

  .toc-label {
    display: none;
  }

  /* モバイルでは目次らしく 1 行 1 項目、罫線で区切る */
  .toc ol {
    display: grid;
    font-size: 0.8125rem;
  }

  .toc li + li {
    border-top: var(--hairline);
  }

  .toc a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    color: var(--color-muted);
    transition: color 200ms var(--ease);
  }

  .toc a::after {
    content: '\2193';
    margin-left: auto;
    color: var(--color-faint);
    transition: transform 200ms var(--ease);
  }

  .toc a:hover,
  .toc a:focus-visible {
    color: var(--color-fg);
  }

  .toc a:hover::after,
  .toc a:focus-visible::after {
    transform: translateY(2px);
  }

  .toc-num {
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .hero-inner {
      padding-top: calc(var(--header-h) + var(--sp-8));
    }

    .hero-main {
      padding-block: var(--sp-4) var(--sp-10);
    }

    h1 {
      margin-bottom: var(--sp-6);
    }

    .facts {
      grid-template-columns: 6rem minmax(0, 1fr);
    }

    .facts dd {
      margin-bottom: 0.5rem;
    }

    .toc {
      padding-block: var(--sp-2);
    }

    .toc-label {
      display: block;
      align-self: center;
    }

    .toc ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--sp-4);
    }

    .toc li + li {
      border-top: 0;
    }

    .toc a {
      display: inline-flex;
      gap: 0.625rem;
    }

    .toc a::after {
      content: none;
    }
  }
</style>
