---
import type { Lang } from '../i18n/utils';
import { t, pick, pickedLang, isSelf } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  /** 年の降順に並んだ特許リスト。 */
  patents: CollectionEntry<'patents'>[];
  /** 本人名の表記ゆれ集合（太字判定に使う）。 */
  selfVariants: Set<string>;
  /** セクション冒頭の一文（profile.yaml の patentNote）。 */
  note?: CollectionEntry<'profile'>['data']['patentNote'];
}

const { lang, patents, selfVariants, note: noteSource } = Astro.props;
const dict = t(lang);
const note = noteSource ? pick(noteSource, lang) : '';
const noteLang = noteSource ? pickedLang(noteSource, lang) : lang;

/** 詳細行（値があるものだけ）。 */
function details(data: CollectionEntry<'patents'>['data']) {
  const rows: { label: string; value: string; lang?: Lang }[] = [];
  if (data.number) rows.push({ label: dict.patents.number, value: data.number });
  if (data.jurisdictions?.length) rows.push({ label: dict.patents.jurisdictions, value: data.jurisdictions.join(', ') });
  if (data.priorityDate) rows.push({ label: dict.patents.priorityDate, value: data.priorityDate });
  if (data.filedDate) rows.push({ label: dict.patents.filedDate, value: data.filedDate });
  if (data.publishedDate) rows.push({ label: dict.patents.publishedDate, value: data.publishedDate });
  if (data.assignee) rows.push({ label: dict.patents.assignee, value: pick(data.assignee, lang), lang: pickedLang(data.assignee, lang) });
  return rows;
}
---

{note && <p class="note muted" lang={noteLang !== lang ? noteLang : undefined}>{note}</p>}

<ol class="patents">
  {
    patents.map(({ data }) => {
      const titleLang = pickedLang(data.title, lang);
      const rows = details(data);
      const summaryLang = data.summary ? pickedLang(data.summary, lang) : lang;
      return (
        <li>
          <span class="mono year">{data.year}</span>
          <div class="body">
            <div class="head">
              <h3 lang={titleLang !== lang ? titleLang : undefined}>{pick(data.title, lang)}</h3>
              {data.status && (
                <p class="meta">
                  <span class:list={['status', 'pill', data.status, { 'is-accent': data.status === 'granted' }]}>
                    {dict.patents[data.status]}
                  </span>
                </p>
              )}
            </div>
            {data.summary && (
              <p class="desc" lang={summaryLang !== lang ? summaryLang : undefined}>
                {pick(data.summary, lang)}
              </p>
            )}
            {rows.length > 0 && (
              <dl class="details">
                {rows.map((row) => (
                  <div class="row">
                    <dt class="label">{row.label}</dt>
                    <dd class:list={{ mono: row.lang === undefined }} lang={row.lang && row.lang !== lang ? row.lang : undefined}>
                      {row.value}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
            {data.inventors && (
              <p class="inventors muted">
                <span class="sr-only">{dict.patents.inventors}: </span>
                {data.inventors.map((inventor, i) => (
                  <>
                    {isSelf(inventor, selfVariants) ? <strong>{inventor}</strong> : inventor}
                    {i < (data.inventors?.length ?? 0) - 1 ? ', ' : ''}
                  </>
                ))}
              </p>
            )}
            {data.link && (
              <p class="links">
                <a class="arrow-link" href={data.link} rel="noopener">
                  {dict.patents.link}
                </a>
              </p>
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  /* Stat strip: large mono figures with small labels */





  .note {
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: var(--sp-4);
    text-wrap: pretty;
  }

  .patents {
    border-bottom: var(--hairline);
  }

  .patents > li {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem var(--sp-3);
    padding-block: var(--sp-3);
    border-top: var(--hairline);
  }

  .patents > li::before {
    content: '';
    position: absolute;
    inset: 0 -0.75rem;
    z-index: -1;
    border-radius: var(--radius);
    background: var(--color-bg-elev);
    opacity: 0;
    transition: opacity 200ms var(--ease);
  }

  .patents > li:hover::before {
    opacity: 1;
  }

  .year {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    padding-top: 0.35rem;
  }

  .body {
    min-width: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 0.75rem;
    margin-bottom: 0.625rem;
  }

  .meta {
    display: inline-flex;
    align-items: center;
  }

  .desc {
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: var(--sp-2);
    text-wrap: pretty;
  }

  .details {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.375rem var(--sp-3);
    padding: 0.75rem 0;
    border-top: 1px dashed var(--color-border);
    border-bottom: 1px dashed var(--color-border);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .row {
    display: grid;
    grid-template-columns: 8.75rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
  }

  .details dd {
    margin: 0;
    font-size: 0.8125rem;
  }

  .details dd.mono {
    font-size: 0.75rem;
  }

  .inventors {
    font-size: 0.9375rem;
    margin-top: 0.75rem;
  }

  .inventors strong {
    font-weight: 600;
    color: var(--color-fg);
  }

  .links {
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {

    .stat dd {
      font-size: 2.5rem;
    }

    .patents > li {
      grid-template-columns: var(--year-col) minmax(0, 1fr);
      padding-block: var(--sp-3) var(--sp-4);
    }

    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
