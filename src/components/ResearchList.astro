---
import type { Lang } from '../i18n/utils';
import { pick, pickedLang } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  items: CollectionEntry<'profile'>['data']['research'];
}

const { lang, items } = Astro.props;
---

<ul class="research">
  {
    items.map((item, i) => {
      const title = pick(item.title, lang);
      const summary = pick(item.summary, lang);
      return (
        <li>
          <span class="mono index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 lang={pickedLang(item.title, lang) !== lang ? pickedLang(item.title, lang) : undefined}>{title}</h3>
          <p class="muted" lang={pickedLang(item.summary, lang) !== lang ? pickedLang(item.summary, lang) : undefined}>
            {summary}
          </p>
        </li>
      );
    })
  }
</ul>

<style>
  .research {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-bottom: var(--hairline);
  }

  .research li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: var(--sp-1);
    padding-block: var(--sp-3);
    border-top: var(--hairline);
  }

  .index {
    grid-row: 1 / span 2;
    font-size: 0.75rem;
    color: var(--color-muted);
    padding-top: 0.3rem;
  }

  h3 {
    margin-bottom: 0.5rem;
  }

  p {
    font-size: 0.9375rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    /* 番号付きの 2 列グリッド。奇数個のときは最後の項目を全幅にして罫線を揃える。 */
    .research {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-5);
    }

    .research li {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr;
      padding-block: var(--sp-3) var(--sp-4);
    }

    .research li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .index {
      grid-row: auto;
      margin-bottom: var(--sp-3);
      padding-top: 0;
    }
  }
</style>
