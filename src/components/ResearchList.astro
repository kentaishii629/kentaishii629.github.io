---
import type { Lang } from '../i18n/utils';
import { pick, pickedLang } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  items: CollectionEntry<'profile'>['data']['research'];
}

const { lang, items } = Astro.props;
---

<ul class="research">
  {
    items.map((item, i) => {
      const title = pick(item.title, lang);
      const summary = pick(item.summary, lang);
      return (
        <li>
          <span class="mono index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 lang={pickedLang(item.title, lang) !== lang ? pickedLang(item.title, lang) : undefined}>{title}</h3>
            <p class="muted" lang={pickedLang(item.summary, lang) !== lang ? pickedLang(item.summary, lang) : undefined}>
              {summary}
            </p>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .research li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 0.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .research li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .index {
    font-size: 0.75rem;
    color: var(--color-muted);
    padding-top: 0.45rem;
  }

  h3 {
    margin-bottom: 0.375rem;
  }

  p {
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
