---
import type { Lang } from '../i18n/utils';
import { t, otherLang } from '../i18n/utils';
import { localePath } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const other = otherLang(lang);
---

<header class="site-header" data-header>
  <div class="container inner">
    <a class="logo" href={localePath(lang)}>Portfolio</a>
    <nav class="lang mono" aria-label={dict.langSwitch.navLabel}>
      {
        // 並びは常に JA / EN で固定し、現在の言語の側に塗りを移す。
        (['ja', 'en'] as const).map((code) =>
          code === lang ? (
            <span class="seg current" aria-current="true">
              <span class="sr-only">{dict.langSwitch.currentLabel}</span>
              <span aria-hidden="true">{dict.langSwitch.current}</span>
            </span>
          ) : (
            <a
              class="seg switch"
              href={localePath(other)}
              hreflang={other}
              lang={other}
              aria-label={dict.langSwitch.switchLabel}
              data-lang-switch
            >
              {dict.langSwitch.other}
            </a>
          ),
        )
      }
    </nav>
  </div>
</header>

<script>
  // スクロール時に半透明背景 + backdrop-filter を付ける。
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // 言語切替時は、いま画面に見えているセクションへ移動する。
  // URL のハッシュは目次を押したときのものが残るので使わない（別の場所を読んでいても、そこへ飛ばされてしまうため）。
  const currentSectionId = (): string | null => {
    const line = (header?.offsetHeight ?? 0) + 24;
    let current: string | null = null;
    for (const section of document.querySelectorAll<HTMLElement>('section.section[id]')) {
      if (section.getBoundingClientRect().top <= line) current = section.id;
    }
    return current;
  };
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]')) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const id = currentSectionId();
      location.href = `${link.href.split('#')[0]}${id ? `#${id}` : ''}`;
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    transition:
      background-color 250ms var(--ease),
      border-color 250ms var(--ease);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: var(--color-header);
    border-color: var(--color-border);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  /* Segmented JA / EN control */
  .lang {
    display: inline-flex;
    align-items: stretch;
    height: 36px;
    padding: 3px;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
  }

  .seg {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    padding-inline: 0.25rem;
    border-radius: 999px;
    transition:
      color 200ms var(--ease),
      background-color 200ms var(--ease);
  }

  .current {
    color: var(--color-bg);
    background: var(--color-fg);
  }

  .switch {
    color: var(--color-muted);
  }

  /* 見た目は 32px だが、タップ領域は 44px 分に広げる。 */
  .switch::before {
    content: '';
    position: absolute;
    inset: -8px -4px;
  }

  .switch:hover,
  .switch:focus-visible {
    color: var(--color-fg);
    background: var(--color-bg-elev);
  }

  .switch:focus-visible {
    outline-offset: 4px;
  }
</style>
