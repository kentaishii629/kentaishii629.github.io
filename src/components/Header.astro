---
import type { Lang } from '../i18n/utils';
import { t, otherLang } from '../i18n/utils';
import { localePath } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const other = otherLang(lang);
---

<header class="site-header" data-header>
  <div class="container inner">
    <a class="logo" href={localePath(lang)}>Portfolio</a>
    <nav class="lang mono" aria-label={dict.langSwitch.navLabel}>
      {
        // 並びは常に JA / EN で固定し、現在の言語の側に塗りを移す。
        (['ja', 'en'] as const).map((code) =>
          code === lang ? (
            <span class="seg current" aria-current="true">
              <span class="sr-only">{dict.langSwitch.currentLabel}</span>
              <span aria-hidden="true">{dict.langSwitch.current}</span>
            </span>
          ) : (
            <a
              class="seg switch"
              href={localePath(other)}
              hreflang={other}
              lang={other}
              aria-label={dict.langSwitch.switchLabel}
              data-lang-switch
            >
              {dict.langSwitch.other}
            </a>
          ),
        )
      }
    </nav>
  </div>
</header>

<script>
  // スクロール時に半透明背景 + backdrop-filter を付ける。
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // 言語切替時に、読んでいた位置をそのまま保つ。
  // 両言語のページは同じ構造（同じ順の章・項目）なので、画面上端にある項目が「何番目の項目か」と
  // 「その項目の中でどこまで読んだか」を覚えておき、切替先のページで同じ項目の同じ位置へ戻す。
  // URL のハッシュは目次を押したときのものが残るので使わない。
  const POS_KEY = 'lang-switch-pos';
  const anchors = () => Array.from(document.querySelectorAll<HTMLElement>('main section, main li'));
  const topLine = () => header?.offsetHeight ?? 0;

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]')) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const line = topLine();
      let index = -1;
      let ratio = 0;
      if (window.scrollY > 0) {
        anchors().forEach((el, i) => {
          const rect = el.getBoundingClientRect();
          // 画面上端より上から始まっている、表示中の項目のうち最後のもの（＝いま読んでいる項目）
          if (rect.height > 0 && rect.top <= line + 1) {
            index = i;
            ratio = Math.min(1, (line - rect.top) / rect.height);
          }
        });
      }
      try {
        if (index >= 0) sessionStorage.setItem(POS_KEY, JSON.stringify({ index, ratio, at: Date.now() }));
        else sessionStorage.removeItem(POS_KEY);
      } catch {
        // 保存できない環境では、切替先のページ冒頭に移動する
      }
      location.href = link.href.split('#')[0] ?? link.href;
    });
  }

  // 切替直後のページで、覚えておいた位置へ戻す。
  try {
    const saved = sessionStorage.getItem(POS_KEY);
    sessionStorage.removeItem(POS_KEY);
    const pos = saved ? (JSON.parse(saved) as { index: number; ratio: number; at: number }) : null;
    if (pos && Date.now() - pos.at < 10000) {
      // 表示アニメーション（下から 14px 浮き上がる）の途中だと位置がずれるので、先に全部表示しておく。
      for (const el of document.querySelectorAll<HTMLElement>('.reveal')) {
        el.style.transition = 'none';
        el.classList.add('is-visible');
      }
      const restore = () => {
        const el = anchors()[pos.index];
        if (!el) return;
        const rect = el.getBoundingClientRect();
        const top = rect.top + window.scrollY - topLine() + rect.height * pos.ratio;
        window.scrollTo({ top, behavior: 'instant' });
      };
      restore();
      // 書体や画像の読み込みで高さが変わることがあるので、読み込み後にもう一度合わせる（利用者が動かしていなければ）。
      let moved = false;
      const markMoved = () => (moved = true);
      window.addEventListener('wheel', markMoved, { once: true, passive: true });
      window.addEventListener('touchmove', markMoved, { once: true, passive: true });
      window.addEventListener('keydown', markMoved, { once: true });
      const again = () => {
        if (!moved) restore();
      };
      document.fonts?.ready.then(again);
      window.addEventListener('load', again, { once: true });
    }
  } catch {
    // 位置を戻せない場合はページ冒頭のまま
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    transition:
      background-color 250ms var(--ease),
      border-color 250ms var(--ease);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: var(--color-header);
    border-color: var(--color-border);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  /* Segmented JA / EN control */
  .lang {
    display: inline-flex;
    align-items: stretch;
    height: 36px;
    padding: 3px;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
  }

  .seg {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    padding-inline: 0.25rem;
    border-radius: 999px;
    transition:
      color 200ms var(--ease),
      background-color 200ms var(--ease);
  }

  .current {
    color: var(--color-bg);
    background: var(--color-fg);
  }

  .switch {
    color: var(--color-muted);
  }

  /* 見た目は 32px だが、タップ領域は 44px 分に広げる。 */
  .switch::before {
    content: '';
    position: absolute;
    inset: -8px -4px;
  }

  .switch:hover,
  .switch:focus-visible {
    color: var(--color-fg);
    background: var(--color-bg-elev);
  }

  .switch:focus-visible {
    outline-offset: 4px;
  }
</style>
