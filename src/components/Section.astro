---
/**
 * 見出し付きの共通セクションラッパー。番号は JetBrains Mono で "01 —" の形。
 * デスクトップでは左の狭い列（番号 + 見出し）が sticky になり、右の本文列がスクロールする。
 */
interface Props {
  id: string;
  number: string;
  title: string;
}

const { id, number, title } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} class="section reveal" aria-labelledby={headingId}>
  <div class="container">
    <div class="grid-aside">
      <div class="section-aside">
        <h2 id={headingId} class="section-title">
          <span class="num" aria-hidden="true">{number} —</span>
          <span>{title}</span>
        </h2>
      </div>
      <div class="section-body">
        <slot />
      </div>
    </div>
  </div>
</section>
