---
import type { Lang } from '../i18n/utils';
import { t, pick, pickedLang } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}

const { lang, profile } = Astro.props;
const dict = t(lang);
const bioLang = pickedLang(profile.bio, lang);
// 空行で段落を分け、段落内の改行は日本語なら詰めて、英語なら空白で連結する。
const lineJoiner = bioLang === 'ja' ? '' : ' ';
const paragraphs = pick(profile.bio, lang)
  .split(/\n{2,}/)
  .map((p) =>
    p
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
      .join(lineJoiner),
  )
  .filter(Boolean);
const affiliations = profile.affiliations.map((a) => ({ text: pick(a, lang), lang: pickedLang(a, lang) }));
---

<div class="about" lang={bioLang !== lang ? bioLang : undefined}>
  {paragraphs.map((p) => <p>{p}</p>)}
</div>

{
  affiliations.length > 0 && (
    <dl class="affiliations">
      <dt class="label">{dict.about.affiliation}</dt>
      {affiliations.map((a) => (
        <dd lang={a.lang !== lang ? a.lang : undefined}>{a.text}</dd>
      ))}
    </dl>
  )
}

<style>
  .about p {
    font-size: 1.0625rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .about p + p {
    margin-top: 1.25rem;
  }

  .affiliations {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem var(--sp-3);
    margin-top: var(--sp-5);
    padding-block: var(--sp-3);
    border-top: var(--hairline);
    border-bottom: var(--hairline);
  }

  dt {
    padding-top: 0.2rem;
  }

  dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .about p {
      font-size: 1.125rem;
    }

    .affiliations {
      grid-template-columns: 10rem minmax(0, 1fr);
    }

    dt {
      grid-column: 1;
      grid-row: 1;
    }

    dd {
      grid-column: 2;
    }
  }
</style>
