---
import type { Lang } from '../i18n/utils';
import { t } from '../i18n/utils';

interface Props {
  lang: Lang;
  name: string;
}

const { lang, name } = Astro.props;
const dict = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="mono muted copy">
      <span>© {year} {name}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>{dict.footer.rights}</span>
    </p>
    <a class="top mono" href="#main">
      <span aria-hidden="true">↑</span>
      {dict.footer.top}
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-1) var(--sp-3);
    padding-block: var(--sp-4) var(--sp-6);
  }

  .copy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .sep {
    color: var(--color-faint);
  }

  .top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    transition: color 200ms var(--ease);
  }

  .top:hover,
  .top:focus-visible {
    color: var(--color-fg);
  }

  @media (min-width: 768px) {
    .inner {
      padding-block: var(--sp-5) var(--sp-8);
    }
  }
</style>
