---
import type { Lang } from '../i18n/utils';
import { t, pick } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}

const { lang, profile } = Astro.props;
const dict = t(lang);

// メールは簡易難読化: ユーザ名とドメインを反転してデータ属性に持たせ、表示時に JS で組み立てる。
const reverse = (s: string) => Array.from(s).reverse().join('');
const emails = profile.emails.map(({ label, address }) => {
  const [user = '', domain = ''] = address.split('@');
  return { user, domain, label: label ? pick(label, lang) : '' };
});

const LINK_ORDER = ['researchmap', 'scholar', 'orcid', 'github'] as const;

/** リンク本文に表示する短い URL（スキームとクエリを落とし、末尾スラッシュを除く）。 */
function shortUrl(href: string): string {
  try {
    const u = new URL(href);
    return `${u.host}${u.pathname}`.replace(/\/$/, '');
  } catch {
    return href;
  }
}

const links = LINK_ORDER.filter((key) => profile.links[key]).map((key) => ({
  key,
  href: profile.links[key],
  label: dict.contact.links[key],
  text: shortUrl(profile.links[key]),
}));
---

<ul class="contact">
  {
    emails.map((email) => (
      <li>
        <span class="key label">{dict.contact.email}</span>
        <span class="value">
          <span class="email mono" data-u={reverse(email.user)} data-d={reverse(email.domain)}>
            {email.user} {dict.contact.emailAt} {email.domain}
          </span>
          {email.label && <span class="affiliation muted">{email.label}</span>}
        </span>
      </li>
    ))
  }
  {
    links.map((link) => (
      <li>
        <span class="key label">{link.label}</span>
        <a class="arrow-link" href={link.href} rel="me noopener">
          {link.text}
        </a>
      </li>
    ))
  }
</ul>

<script>
  // 難読化したメールアドレスを復元して mailto リンクに置き換える。
  const reverse = (s: string) => Array.from(s).reverse().join('');
  for (const el of document.querySelectorAll<HTMLElement>('.email[data-u][data-d]')) {
    const address = `${reverse(el.dataset.u ?? '')}@${reverse(el.dataset.d ?? '')}`;
    const a = document.createElement('a');
    a.className = 'arrow-link';
    a.href = `mailto:${address}`;
    a.textContent = address;
    el.replaceWith(a);
  }
</script>

<style>

  .contact {
    border-bottom: var(--hairline);
  }

  .contact li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 0 var(--sp-3);
    padding-block: 0.625rem;
    border-top: var(--hairline);
  }

  .key {
    padding-top: 0.5rem;
  }

  .value {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding-bottom: 0.375rem;
  }

  .email {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .affiliation {
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .contact :global(.arrow-link) {
    min-height: 44px;
    font-size: 0.8125rem;
    max-width: 100%;
  }

  .contact :global(.arrow-link) {
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {

    .contact li {
      grid-template-columns: 10rem minmax(0, 1fr);
      padding-block: 0.25rem;
    }

    .key {
      padding-top: 0;
    }
  }
</style>
