---
import type { Lang } from '../i18n/utils';
import { t, pick, pickedLang, isSelf } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  /** 年の降順に並んだ論文リスト。 */
  pubs: CollectionEntry<'publications'>[];
  /** 本人名の表記ゆれ集合（太字判定に使う）。 */
  selfVariants: Set<string>;
}

const { lang, pubs, selfVariants } = Astro.props;
const dict = t(lang);

const TYPE_ORDER = ['journal', 'conference', 'preprint', 'talk', 'other'] as const;
const presentTypes = TYPE_ORDER.filter((type) => pubs.some((p) => p.data.type === type));
const LINK_ORDER = ['doi', 'pdf', 'arxiv', 'url'] as const;
const listId = 'publications-list';
---

{
  presentTypes.length > 1 && (
    <div class="tabs" role="group" aria-label={dict.publications.filterLabel} data-pub-filter={listId}>
      <button type="button" class="tab" data-filter="all" aria-pressed="true">
        {dict.publications.types.all}
      </button>
      {presentTypes.map((type) => (
        <button type="button" class="tab" data-filter={type} aria-pressed="false">
          {dict.publications.types[type]}
        </button>
      ))}
    </div>
  )
}

<ol class="pubs" id={listId}>
  {
    pubs.map(({ data }) => {
      const titleLang = pickedLang(data.title, lang);
      const venueLang = pickedLang(data.venue, lang);
      const links = LINK_ORDER.filter((key) => data.links[key]);
      return (
        <li data-type={data.type}>
          <span class="mono year">{data.year}</span>
          <div class="body">
            <h3 lang={titleLang !== lang ? titleLang : undefined}>{pick(data.title, lang)}</h3>
            <p class="authors">
              {data.authors.map((author, i) => (
                <>
                  {isSelf(author, selfVariants) ? <strong>{author}</strong> : author}
                  {i < data.authors.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
            <p class="venue muted" lang={venueLang !== lang ? venueLang : undefined}>
              {pick(data.venue, lang)}
              {data.note && <span class="note pill is-accent">{pick(data.note, lang)}</span>}
            </p>
            {links.length > 0 && (
              <ul class="links">
                {links.map((key) => (
                  <li>
                    <a class="arrow-link" href={data.links[key]} rel="noopener">
                      {dict.publications.links[key]}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
<p class="empty muted" data-pub-empty={listId} hidden>{dict.publications.empty}</p>

<script>
  // 種別タブによる最小限のフィルタ。JS 無効時は全件表示のまま。
  for (const group of document.querySelectorAll<HTMLElement>('[data-pub-filter]')) {
    const listId = group.dataset.pubFilter ?? '';
    const list = document.getElementById(listId);
    const empty = document.querySelector<HTMLElement>(`[data-pub-empty="${listId}"]`);
    if (!list) continue;
    const buttons = group.querySelectorAll<HTMLButtonElement>('button[data-filter]');
    const items = list.querySelectorAll<HTMLLIElement>('li[data-type]');

    const apply = (filter: string) => {
      let visible = 0;
      for (const item of items) {
        const show = filter === 'all' || item.dataset.type === filter;
        item.hidden = !show;
        if (show) visible += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
      if (empty) empty.hidden = visible > 0;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
    }
  }
</script>

<style>
  /* Filter: flat mono tabs with an underline marker, not pills */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-3);
    margin-bottom: var(--sp-2);
  }

  .tab {
    position: relative;
    min-height: 44px;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    transition: color 200ms var(--ease);
  }

  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms var(--ease);
  }

  .tab:hover {
    color: var(--color-fg);
  }

  .tab[aria-pressed='true'] {
    color: var(--color-fg);
  }

  .tab[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  .pubs {
    border-bottom: var(--hairline);
  }

  .pubs > li {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem var(--sp-3);
    padding-block: var(--sp-3);
    border-top: var(--hairline);
  }

  /* 行全体に薄い背景をのせる（罫線の位置は変えず、左右に少しはみ出す） */
  .pubs > li::before {
    content: '';
    position: absolute;
    inset: 0 -0.75rem;
    z-index: -1;
    border-radius: var(--radius);
    background: var(--color-bg-elev);
    opacity: 0;
    transition: opacity 200ms var(--ease);
  }

  .pubs > li:hover::before {
    opacity: 1;
  }

  .year {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    padding-top: 0.35rem;
  }

  .body {
    min-width: 0;
  }

  h3 {
    margin-bottom: 0.5rem;
  }

  .authors {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 0.25rem;
  }

  .authors strong {
    font-weight: 600;
  }

  .venue {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .note {
    margin-left: 0.5rem;
    vertical-align: 0.1em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-3);
    margin-top: 0.5rem;
  }

  .empty {
    padding-block: var(--sp-3);
    font-size: 0.9375rem;
  }

  @media (min-width: 768px) {
    .pubs > li {
      grid-template-columns: var(--year-col) minmax(0, 1fr);
      padding-block: var(--sp-3) var(--sp-4);
    }
  }
</style>
