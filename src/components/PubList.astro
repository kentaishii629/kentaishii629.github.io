---
import type { Lang } from '../i18n/utils';
import { t, pick, pickedLang, isSelf } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  /** 年の降順に並んだ論文リスト。 */
  pubs: CollectionEntry<'publications'>[];
  /** 本人名の表記ゆれ集合（太字判定に使う）。 */
  selfVariants: Set<string>;
}

const { lang, pubs, selfVariants } = Astro.props;
const dict = t(lang);

const TYPE_ORDER = ['journal', 'conference', 'preprint', 'talk', 'other'] as const;
const presentTypes = TYPE_ORDER.filter((type) => pubs.some((p) => p.data.type === type));
const LINK_ORDER = ['doi', 'pdf', 'arxiv', 'url'] as const;
const listId = 'publications-list';
---

{
  presentTypes.length > 1 && (
    <div class="tabs" role="group" aria-label={dict.publications.filterLabel} data-pub-filter={listId}>
      <button type="button" class="tab mono" data-filter="all" aria-pressed="true">
        {dict.publications.types.all}
      </button>
      {presentTypes.map((type) => (
        <button type="button" class="tab mono" data-filter={type} aria-pressed="false">
          {dict.publications.types[type]}
        </button>
      ))}
    </div>
  )
}

<ol class="pubs" id={listId}>
  {
    pubs.map(({ data }) => {
      const titleLang = pickedLang(data.title, lang);
      const venueLang = pickedLang(data.venue, lang);
      const links = LINK_ORDER.filter((key) => data.links[key]);
      return (
        <li data-type={data.type}>
          <span class="mono year">{data.year}</span>
          <div class="body">
            <h3 lang={titleLang !== lang ? titleLang : undefined}>{pick(data.title, lang)}</h3>
            <p class="authors">
              {data.authors.map((author, i) => (
                <>
                  {isSelf(author, selfVariants) ? <strong>{author}</strong> : author}
                  {i < data.authors.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
            <p class="venue muted" lang={venueLang !== lang ? venueLang : undefined}>
              {pick(data.venue, lang)}
              {data.note && <span class="note mono">{pick(data.note, lang)}</span>}
            </p>
            {links.length > 0 && (
              <ul class="links mono">
                {links.map((key) => (
                  <li>
                    <a class="link" href={data.links[key]} rel="noopener">
                      {dict.publications.links[key]}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>
<p class="empty muted" data-pub-empty={listId} hidden>{dict.publications.empty}</p>

<script>
  // 種別タブによる最小限のフィルタ。JS 無効時は全件表示のまま。
  for (const group of document.querySelectorAll<HTMLElement>('[data-pub-filter]')) {
    const listId = group.dataset.pubFilter ?? '';
    const list = document.getElementById(listId);
    const empty = document.querySelector<HTMLElement>(`[data-pub-empty="${listId}"]`);
    if (!list) continue;
    const buttons = group.querySelectorAll<HTMLButtonElement>('button[data-filter]');
    const items = list.querySelectorAll<HTMLLIElement>('li[data-type]');

    const apply = (filter: string) => {
      let visible = 0;
      for (const item of items) {
        const show = filter === 'all' || item.dataset.type === filter;
        item.hidden = !show;
        if (show) visible += 1;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
      if (empty) empty.hidden = visible > 0;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
    }
  }
</script>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.75rem;
  }

  .tab {
    min-height: 40px;
    padding: 0.25rem 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition:
      color 200ms var(--ease),
      border-color 200ms var(--ease),
      background-color 200ms var(--ease);
  }

  .tab:hover {
    color: var(--color-fg);
    border-color: var(--color-muted);
  }

  .tab[aria-pressed='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .pubs > li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .pubs > li:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .year {
    font-size: 0.8125rem;
    color: var(--color-muted);
    padding-top: 0.3rem;
  }

  h3 {
    margin-bottom: 0.375rem;
  }

  .authors {
    font-size: 0.9375rem;
    margin-bottom: 0.125rem;
  }

  .authors strong {
    font-weight: 600;
  }

  .venue {
    font-size: 0.9375rem;
  }

  .note {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    color: var(--color-accent);
    border: 1px solid currentColor;
    border-radius: 999px;
    line-height: 1.6;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .empty {
    padding-block: 1.5rem;
  }

  @media (min-width: 768px) {
    .pubs > li {
      grid-template-columns: 4.5rem 1fr;
    }
  }
</style>
